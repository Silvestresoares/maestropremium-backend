# ==========================================
# Maestro Cifras - Variáveis de Ambiente (Backend)
# ==========================================

PORT=3333
NODE_ENV=production

# Banco de Dados PostgreSQL (Neon Cloud com SSL)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Autenticação JWT
JWT_SECRET=sua_chave_jwt_super_segura_aqui

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=sua_vapid_public_key
VAPID_PRIVATE_KEY=sua_vapid_private_key
VAPID_SUBJECT=mailto:suporte@maestropremium.com

# Gateway de Pagamentos Asaas
ASAAS_API_KEY=sua_chave_de_api_asaas
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=seu_webhook_token_asaas

# Armazenamento em Nuvem Cloudinary (para anexos e capas)
CLOUDINARY_API_KEY=sua_api_key_cloudinary
CLOUDINARY_API_SECRET=sua_api_secret_cloudinary
CLOUDINARY_CLOUD_NAME=seu_cloud_name_cloudinary

# Envio de E-mails Transacionais (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_google

# Origem do Frontend (CORS)
FRONTEND_URL=https://tomeordem.vercel.app

# Caminho do Chromium no Container Docker (definido no Dockerfile)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
